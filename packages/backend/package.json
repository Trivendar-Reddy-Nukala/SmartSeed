{
  "name": "@smartseed/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "knex migrate:latest --knexfile src/database/knexfile.ts",
    "db:rollback": "knex migrate:rollback --knexfile src/database/knexfile.ts",
    "db:seed": "knex seed:run --knexfile src/database/knexfile.ts",
    "test": "jest"
  },
  "dependencies": {
    "@smartseed/shared": "*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "bullmq": "^5.25.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "qrcode": "^1.5.4",
    "crypto-js": "^4.2.0",
    "winston": "^3.17.0",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "socket.io": "^4.8.0",
    "dotenv": "^16.4.0",
    "axios": "^1.7.0",
    "hpp": "^0.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/crypto-js": "^4.2.2",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.16",
    "@types/hpp": "^0.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.2.0"
  }
}
