# ========================
# SmartSeed Environment
# ========================

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_DEEP_LINK_URL=smartseed://

# Database
DATABASE_URL=postgresql://smartseed:smartseed_dev_2026@localhost:5432/smartseed_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartseed_dev
DB_USER=smartseed
DB_PASSWORD=smartseed_dev_2026
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Blockchain
HLF_CHANNEL_NAME=seedchannel
HLF_CHAINCODE_NAME=smartseed
HLF_CONNECTION_PROFILE=./packages/blockchain/network/connection-org1.json
HLF_WALLET_PATH=./packages/blockchain/wallet

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=change-this-in-production

# Object Storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartseed
S3_REGION=us-east-1

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smartseed.example

# QR Code
QR_BASE_URL=http://localhost:5173/verify

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

